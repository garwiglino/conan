{"modelVersion":2,"piskel":{"name":"gobelin-tenues-villageois","description":"Villageois : tunique de laine ajustée au corps gobelin, braies, ceinture de corde, bourse, bandes de pied. Cadres : face, droite, dos, gauche.","fps":2,"height":48,"width":48,"layers":["{\"name\":\"REFERENCE - corps (dessous, non assemble)\",\"opacity\":0.35,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}","{\"name\":\"HABIT 10 - Bandes de pied\",\"opacity\":1,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}","{\"name\":\"HABIT 11 - Braies\",\"opacity\":1,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}","{\"name\":\"HABIT 12 - Tunique\",\"opacity\":1,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}","{\"name\":\"HABIT 15 - Ceinture de corde\",\"opacity\":1,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}","{\"name\":\"HABIT 16 - Bourse\",\"opacity\":1,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}","{\"name\":\"HABIT 13 - Manches courtes\",\"opacity\":1,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}","{\"name\":\"REFERENCE - corps (dessus, non assemble)\",\"opacity\":0.35,\"frameCount\":4,\"chunks\":[{\"layout\":[[0],[1],[2],[3]],\"base64PNG\":\"data:image/png;base64,\"}]}"]}}